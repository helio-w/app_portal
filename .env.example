# Copy this file to .env and fill in the values. Never commit .env.

# Required in production. Generate one with:
#   python3 -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# Comma-separated host names the site is served on
DJANGO_ALLOWED_HOSTS=127.0.0.1,example.org
# Comma-separated origins, scheme included (needed behind HTTPS for admin login / API writes)
CSRF_TRUSTED_ORIGINS=https://example.org

# Optional: a superuser is created at container start if both are set and the user doesn't exist yet
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=
DJANGO_SUPERUSER_EMAIL=
